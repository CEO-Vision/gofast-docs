#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:529
#: 14b1ead01cd544c18a7d6a0d53dc37ae
msgid ""
"**Pour s’abonner à un Espace Collaboratif :** Merci de vous référer à la "
"rubrique : « s'abonner ou se désabonner d'un Espace Collaboratif »"
msgstr ""
