#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:926
#: 325e7d1894aa4c108a2de07457119a60
msgid ""
"Partager / Ajouter des emplacements (Multi-emplacement = zéro doublon de "
"fichier)"
msgstr "Sharing/Adding locations (Multi-location = zero file duplicates)"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:927
