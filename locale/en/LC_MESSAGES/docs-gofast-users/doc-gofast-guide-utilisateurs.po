#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:378
#: 7231c6aa550241d092a1658eefa82215
msgid "Par défaut, elle est initialement attribuée au créateur de l’espace"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:385
#: 8cf1ecab5b164de3a9dae4688db14717
