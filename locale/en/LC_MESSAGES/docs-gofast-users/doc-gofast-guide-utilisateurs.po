msgstr "Display of the result by relevance"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:372
#: 202f8d37a0bc4fc8934291c6c3eac195
msgid ""
"Tout un ensemble de critères est pris en compte dans le calcul de cette "
"pertinence, dont :"
msgstr ""
"A whole set of criteria is taken into account in the calculation of this "
"relevance, including:"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:369
#: ada4594cf97e43d6a9b1c1373d67fcd2
msgid "le nombre d’occurrences des mots-clefs recherchés,"
