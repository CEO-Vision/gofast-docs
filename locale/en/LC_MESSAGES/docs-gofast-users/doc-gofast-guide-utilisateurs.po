#: c9702c08a33d4fcba58e9a657958216d
msgid "Annuaire des Liste d'Utilisateurs"
msgstr "User List Directory"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:478
#: 8d1627a3fcab4a408547deb30a760ece
msgid ""
"Pour consulter les listes existantes, il suffit de passer par les "
