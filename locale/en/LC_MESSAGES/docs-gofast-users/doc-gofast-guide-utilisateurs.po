#: ecf6c9b458f6484b8abb0f19d86c27b1
msgid ""
"Cliquer sur le menu « Burger » (actions contextuelles) sur la page de la "
"Liste ou depuis l’annuaire des Listes d’Utilisateurs."
msgstr ""
"Click on the “Hamburger” menu (contextual actions) on the List page or "
"from the User Lists directory."

