msgstr "Open in active tab (replaces current view)"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:803
#: 5d78f06408bb431db80f8fa206daf7d7
msgid "Actions sur une sélection de fichiers ou dossier (classique)"
msgstr "Actions on a selection of files or folders (classic)"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:804
#: 28c67805088749d1bf23406f03956fb0
