#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:869
#: ba8b2a27e14b4f479161a2b7434e6d11
msgid "Il est possible d'envoyer plusieurs fichiers via un partage par mail."
msgstr "It is possible to send multiple files via email sharing."

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:871
#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:895
#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:918
#: 1bc3b82d9d3247d6a8eee46a11756a0e 60672da2d7d447e5abd4f252beb7506c
