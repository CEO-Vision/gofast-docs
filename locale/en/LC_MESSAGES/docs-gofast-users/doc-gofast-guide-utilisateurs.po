msgid "Responsable"
msgstr "Responsable"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1085
#: 03596aeca65d4f9e9ecbe9fad314cc71
msgid "Participants"
msgstr "Participants"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1085
#: 12738d3f7df445739c8fecd9a081c5c9
msgid "Assignés aux actions"
msgstr "Assigned to actions"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1087
#: ca9762838d14429d9e0900824d297b13
msgid "Création de carte"
msgstr "Card creation"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1087
#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1089
#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_3.rst:1091
