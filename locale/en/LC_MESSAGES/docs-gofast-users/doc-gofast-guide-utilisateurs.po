#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:370
#: d0144b4d813d4db6802c2d1ed0a6a2c9
msgid ""
"les emplacements des mots-clefs (ex : titre du fichier, d’un paragraphe "
"dans le document…),"
msgstr ""
"the locations of the keywords (e.g.: file title, a paragraph in the "
"document, etc.),"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:371
#: 1ef6228b78c14b4a94b5cf9694c7677f
msgid ""
"les dates de création et modification (ex : un contenu récent sera "
"privilégié vis-à-vis d’un document ancien),"
msgstr ""
"creation and modification dates (for example, recent content would be "
"preferred over an old document),"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:372
#: 40cae828991f4528ad9282cf487f4a34
msgid ""
"la popularité des contenus (ex : un document consulté souvent sera "
"privilégié vis-à-vis d’un document qui n’a pas été consulté depuis des "
"mois)."
msgstr ""
"the popularity of the content (e.g. a document viewed often will be "
"favored over a document which has not been viewed for months)."

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:375
#: 49d7537818e241ab88a656b5a75208c6
msgid "Actions depuis le résultat de recherche"
msgstr "Actions from the search result"

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:383
