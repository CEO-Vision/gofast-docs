#: b92a4aaacf7942ce94fcb8aa0c9fe677
msgid "Affichage du résultat par pertinence"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:372
#: ffa257657c624397b9a20f78b260a319
msgid ""
"Tout un ensemble de critères est pris en compte dans le calcul de cette "
"pertinence, dont :"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:369
#: a3c64fc043314bf6b43fcf01a3f7239f
msgid "le nombre d’occurrences des mots-clefs recherchés,"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:370
#: 4766e3f1c20d48a98a37159765dbcdc4
msgid ""
"les emplacements des mots-clefs (ex : titre du fichier, d’un paragraphe "
"dans le document…),"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:371
#: 9312767662574daf84d55264443a4751
msgid ""
"les dates de création et modification (ex : un contenu récent sera "
"privilégié vis-à-vis d’un document ancien),"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:372
#: 6abe4757cf1c49008b34b08fa0604c31
msgid ""
"la popularité des contenus (ex : un document consulté souvent sera "
"privilégié vis-à-vis d’un document qui n’a pas été consulté depuis des "
"mois)."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_2.rst:375
#: 97cff9f7270d4d55bd457739dc903232
