#: ../../docs-gofast-users/doc-gofast-problemes-connus.rst:170
#: 9ca3293fae6f41f6a43f24fe6596dc3c
msgid "Si cela arrive au tout début de la webconference, rafraichir la page ou clic sur F5"
msgstr ""

