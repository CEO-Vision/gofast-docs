#: 752474778e804d448fde501732c679d2
msgid "Ce problème est souvent la conséquence d'un dysfonctionnement du \"Centre de Téléchargement Office\". Ce centre est fait pour éviter de perdre son travail dans le cas d'une déconnexion avec le serveur distant (ici : GoFAST). Toutefois, il arrive que celui-ci bloque l'envoi des fichiers. Ces fichiers bloqués sont listés dans le centre de téléchargement."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-problemes-connus.rst:37
#: a80e4606bd3e44f4bf667eea66ee6c97
