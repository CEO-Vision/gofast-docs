#: cf15a9dc1edd424ca355b3c3000531b6
msgid "1/ Plutôt que \"Enregistrer\", allez dans \"Enregistrer sous\", puis cliquez sur \"Récents\" et enfin sélectionnez le dossier où se trouve votre fichier. Enregistrez votre version en écrasant le fichier qui est sur le serveur."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-problemes-connus.rst:44
#: df49a575a89446a4a1af930191ebfbe3
