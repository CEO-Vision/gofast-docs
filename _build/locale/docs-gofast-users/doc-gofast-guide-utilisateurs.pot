#: e314b4d14dab4869bda5b6a526978728
msgid "Le tableau de bord permet un accès rapide aux éléments les plus sollicités. Par défaut, tous les utilisateurs ont le même tableau de bord."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs.rst:393
#: 3f07216b3e484ba298fec47463a1467e
