#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:567
#: 60ccadb3c38a4e2c8eb77d15cbe10b0b
msgid "Sélectionnez votre document cible dans la liste des suggestions."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:568
#: ae26432e5caf4adaa9c7ebc03436d618
msgid "Cliquez sur « Mettre à jour les traductions » pour sauvegarder vos liens de traductions."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:573
#: a46b8a76d92f473fb46574519a9fd1c2
msgid "**Lier un document existant à un document de traduction à charger depuis votre PC :**"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:575
#: 7f3650c99ded4fe78d209a21f62daaa8
msgid "Dans la fenêtre de gestion des traductions, cliquez sur le bouton « + » au niveau du drapeau qui correspond à la langue du document cible."
