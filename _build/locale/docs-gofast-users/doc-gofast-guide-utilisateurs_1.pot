#: 8233b4529fbf435ba7765372e7b41df4
msgid "Vous serez alors redirigé vers le formulaire de création de document."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:577
#: 1d40fcbab1e74122ab424d1a9e5f3874
msgid "Le titre de votre document sera prérempli, avec à la fin du titre les lettres qui correspondent à la langue ciblée (ex . /_EN)"
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:578
#: 0e356d9c74644efdb5c5d6f4ba0964b7
msgid "Selon sur la langue cible choisie, la langue du document cible sera pré-renseignée."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:579
#: fe18d3e624fb4426a3ba289ab47f3fa6
msgid "Cliquez sur « Choisissez un fichier » et votre explorateur de fichiers local s’ouvre (celui de votre PC)."
msgstr ""

#: ../../docs-gofast-users/doc-gofast-guide-utilisateurs_1.rst:580
#: 6b327c339b55429eb739254f6021fff4
msgid "Allez chercher votre document cible dans votre arborescence et cliquez sur « ouvrir » (ou faites un double-clic sur le document)."
msgstr ""

